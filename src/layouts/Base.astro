---
interface Props {
  title: string;
  description: string;
  robots?: string;
}

const { title, description, robots } = Astro.props;
const currentYear = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101512" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    {robots && <meta name="robots" content={robots} />}
    <meta name="author" content="Basem Sufan" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Basem Sufan" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://xb3sox.github.io/" />
    <meta property="og:image" content="https://xb3sox.github.io/og.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Basem Sufan — AI Product Builder, Riyadh, Saudi Arabia" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@xb3sox" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://xb3sox.github.io/og.png" />
    <meta name="twitter:image:alt" content="Basem Sufan — AI Product Builder, Riyadh, Saudi Arabia" />
    <link rel="canonical" href="https://xb3sox.github.io/" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='8' fill='%2318211d'/%3E%3Ctext x='20' y='27' font-family='Arial,sans-serif' font-size='16' font-weight='700' fill='white' text-anchor='middle'%3EBS%3C/text%3E%3C/svg%3E" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="container">
      <header class="site-header">
        <a class="brand" href="/">Basem Sufan</a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="/#work">Work</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>
      </header>

      <main id="main" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <span>© {currentYear} Basem Sufan · Riyadh, Saudi Arabia · No trackers, no cookies</span>
        <nav class="social-links" aria-label="Social links">
          <a href="https://github.com/xb3sox" rel="me noopener noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/xb3sox" rel="me noopener noreferrer">LinkedIn</a>
          <a href="https://x.com/xb3sox" rel="me noopener noreferrer">X</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
