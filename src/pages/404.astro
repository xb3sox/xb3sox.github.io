---
import '../styles/global.css';
import '../styles/ui.css';
import Base from '../layouts/Base.astro';
import { Button } from '../components/ui';
---
<Base
  title="Page not found — Basem Sufan"
  description="The page you requested does not exist."
  robots="noindex"
>
  <section class="hero" aria-labelledby="notfound-title">
    <p class="eyebrow">Error 404</p>
    <h1 id="notfound-title">Page not found.</h1>
    <p class="intro">The link may be old, or the page never existed. Let’s get you back.</p>
    <div class="hero-links">
      <Button as="a" variant="outline" class="cta" href="/">Back to homepage <span class="arrow arrow-up" aria-hidden="true">↗</span></Button>
    </div>
  </section>
</Base>
