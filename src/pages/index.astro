---
import '../styles/global.css';
import '../styles/ui.css';
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { Button, Badge, Separator } from '../components/ui';
---
<Base
  title="Basem Sufan | AI Product Builder"
  description="Basem Sufan builds practical AI products in Riyadh, Saudi Arabia."
>
  <script type="application/ld+json" is:inline slot="head">
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "name": "Basem Sufan | AI Product Builder",
    "url": "https://xb3sox.github.io/",
    "mainEntity": {
      "@type": "Person",
      "name": "Basem Sufan",
      "jobTitle": "AI Product Builder",
      "url": "https://xb3sox.github.io/",
      "email": "mailto:Basem.igi@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Riyadh",
        "addressCountry": "SA"
      },
      "sameAs": [
        "https://github.com/xb3sox",
        "https://www.linkedin.com/in/xb3sox",
        "https://x.com/xb3sox"
      ]
    }
  }
  </script>

  <section class="hero" id="home" aria-labelledby="hero-title">
    <div class="hero-mark" aria-hidden="true">ب</div>
    <p class="eyebrow">AI product builder · Riyadh, Saudi Arabia</p>
    <h1 id="hero-title">Make AI useful.<br /><span>Make products matter.</span></h1>
    <p class="intro">I’m Basem. I build practical AI for everyday workflows, with Arabic-first experiences at the center.</p>
    <div class="hero-links">
      <a class="text-link" href="#work">Selected ventures <span class="arrow arrow-down" aria-hidden="true">↓</span></a>
      <Button as="a" variant="outline" class="cta" href="mailto:Basem.igi@gmail.com?subject=Let%E2%80%99s%20talk">Let’s talk <span class="arrow arrow-up" aria-hidden="true">↗</span></Button>
    </div>
  </section>

  <Separator />

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="section-heading">
      <h2 id="work-title">Selected ventures</h2>
      <p class="section-note">Planned launches · strongest concepts first</p>
    </div>

    <div class="project-list">
      {projects.map((project) => (
        <article class="project" aria-labelledby={`${project.id}-title`}>
          <span class="project-number">{project.number}</span>
          <div class="project-copy">
            <h3 id={`${project.id}-title`}>
              {project.name}
              {project.arabic && <span class="project-arabic" lang="ar" dir="rtl">({project.arabic})</span>}
              {project.alias && <span class="project-alias"> · {project.alias}</span>}
            </h3>
            <p>{project.description}</p>
          </div>
          <Badge variant="secondary" shape="pill" size="sm" class="project-status">{project.status}</Badge>
        </article>
      ))}
    </div>
  </section>

  <Separator />

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="section-heading">
      <h2 id="about-title">How I work</h2>
    </div>
    <p class="about-copy">I pair product thinking with engineering to build software for real workflows.</p>
    <ul class="focus-list" aria-label="Areas of focus">
      <li>Product engineering</li>
      <li>AI with evaluation</li>
      <li>Arabic-first design</li>
    </ul>
    <p class="toolkit"><strong>Toolkit</strong> React · Next.js · TypeScript · Python · FastAPI · PostgreSQL</p>
  </section>

  <Separator />

  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <div>
      <h2 id="contact-title">Have a good problem?</h2>
      <p class="contact-copy">Building an AI product or improving a workflow? Let’s talk.</p>
    </div>
    <Button as="a" variant="outline" class="cta" href="mailto:Basem.igi@gmail.com?subject=Project%20enquiry">Email Basem <span class="arrow arrow-up" aria-hidden="true">↗</span></Button>
  </section>
</Base>
