---
import '../styles/global.css';
import { projects } from '../data/projects';

const currentYear = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Basem Sufan — AI Product Builder</title>
    <meta name="description" content="Basem Sufan builds practical AI products in Riyadh, Saudi Arabia." />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Basem Sufan — AI Product Builder" />
    <meta property="og:description" content="Practical AI products, built around real problems. Based in Riyadh, Saudi Arabia." />
    <meta property="og:url" content="https://xb3sox.github.io/" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://xb3sox.github.io/" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' rx='8' fill='%2318211d'/%3E%3Ctext x='20' y='27' font-family='Arial,sans-serif' font-size='16' font-weight='700' fill='white' text-anchor='middle'%3EBS%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="container">
      <header class="site-header">
        <a class="brand" href="#home">Basem Sufan</a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href="#work">Work</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <main id="main">
        <section class="hero" id="home" aria-labelledby="hero-title">
          <p class="eyebrow">AI product builder · Riyadh, Saudi Arabia</p>
          <h1 id="hero-title">Make AI useful.<br /><span>Make products matter.</span></h1>
          <p class="intro">I’m Basem. I build practical AI products around real customer problems, with a focus on Arabic-first experiences and everyday workflows.</p>
          <div class="hero-links">
            <a class="text-link" href="#work">Selected ventures <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="mailto:Basem.igi@gmail.com?subject=Let%E2%80%99s%20talk">Let’s talk <span aria-hidden="true">↗</span></a>
          </div>
        </section>

        <section class="section" id="work" aria-labelledby="work-title">
          <div class="section-heading">
            <h2 id="work-title">Selected ventures</h2>
            <p class="section-note">Planned launches · ordered by concept distinctiveness</p>
          </div>

          <div class="project-list">
            {projects.map((project) => (
              <article class="project" aria-labelledby={`${project.id}-title`}>
                <span class="project-number">{project.number}</span>
                <div class="project-copy">
                  <h3 id={`${project.id}-title`}>
                    {project.name}
                    {project.arabic && <span class="project-arabic" lang="ar" dir="rtl">({project.arabic})</span>}
                    {project.alias && <span class="project-alias"> · {project.alias}</span>}
                  </h3>
                  <p>{project.description}</p>
                </div>
                <span class="project-status">{project.status}</span>
              </article>
            ))}
          </div>
        </section>

        <section class="section" id="about" aria-labelledby="about-title">
          <div class="section-heading">
            <h2 id="about-title">How I work</h2>
          </div>
          <p class="about-copy">I work across product thinking and engineering to make useful software feel clear, capable, and trustworthy. My focus is practical AI, Arabic and RTL experiences, and the systems behind them.</p>
          <ul class="focus-list" aria-label="Areas of focus">
            <li>Product engineering</li>
            <li>AI with evaluation</li>
            <li>Arabic-first design</li>
          </ul>
          <p class="toolkit"><strong>Toolkit</strong> React · Next.js · TypeScript · Python · FastAPI · PostgreSQL</p>
        </section>

        <section class="section contact" id="contact" aria-labelledby="contact-title">
          <div>
            <h2 id="contact-title">Have a good problem?</h2>
            <p class="contact-copy">Building an AI product or improving a real workflow? I’d like to hear about it.</p>
          </div>
          <a class="contact-link" href="mailto:Basem.igi@gmail.com?subject=Project%20enquiry">Email Basem <span aria-hidden="true">↗</span></a>
        </section>
      </main>

      <footer class="site-footer">
        <span>© {currentYear} Basem Sufan · Riyadh, Saudi Arabia</span>
        <nav class="social-links" aria-label="Social links">
          <a href="https://github.com/xb3sox" rel="me noopener noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/xb3sox" rel="me noopener noreferrer">LinkedIn</a>
          <a href="https://x.com/xb3sox" rel="me noopener noreferrer">X</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
